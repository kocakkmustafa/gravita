        "id": "torso_lean",
        "metric": "torso_angle_from_vertical",
        "op": ">",
        "value": 16,
        "sustainedMs": 1500,
        "action": "warn",
        "cue": "Stand taller — you're leaning as you walk."
      },
      {
        "id": "shoulder_drop",
        "metric": "elbow_angle_asymmetry",
        "op": ">",
        "value": 18,
        "sustainedMs": 2000,
        "action": "warn",
        "cue": "Keep both shoulders level."
      }
    ],
    "endsOn": [
      "form_break_sustained",
      "user_stop",
      "confidence_lost"
    ]
  },
  "measurementContract": {
    "measured": [
      "Carry duration",
      "Torso upright over time",
      "Shoulder level symmetry",
      "Time until posture starts to break"
    ],
    "notMeasured": [
      "The weights are not detected — load and distance are not measured",
      "Grip endurance",
      "Steps or pace"
    ],
    "gateableMetrics": [
      "hold_duration_s",
      "torso_angle_from_vertical",
      "time_to_form_break_s"
