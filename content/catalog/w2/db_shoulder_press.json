{
  "schemaVersion": 1,
  "id": "db_shoulder_press",
  "name": "Dumbbell Shoulder Press",
  "family": "shoulders",
  "muscleGroups": [
    "front_delts",
    "triceps",
    "upper_chest"
  ],
  "equipment": [
    "dumbbells"
  ],
  "wave": 2,
  "level": "beginner",
  "class": "A",
  "classRationale": "Açık zincir · ayakta/oturur · itiş yolu DÜŞEY ve sagittal düzlemde yandan görünür (bench press'ten farkı: yol kameranın derinlik eksenini kesmiyor).",
  "camera": {
    "setup": "side",
    "framing": "upper_body",
    "calibrationGate": true
  },
  "engine": {
    "type": "repFsm",
    "signal": {
      "kind": "jointAngle",
      "joint": "elbow",
      "side": "visible"
    },
    "phases": {
      "top": {
        "angleMin": 160
      },
      "descent": {
        "direction": "decreasing"
      },
      "bottom": {
        "angleMax": 80
      },
      "ascent": {
        "direction": "increasing"
      }
    },
    "repCountedOn": "bottom->top",
    "minPhaseMs": 250,
    "timeoutMs": 9000,
    "tempo": {
      "reportDescentMs": true,
      "reportAscentMs": true
    }
  },
  "measurementContract": {
    "measured": [
      "Rep count",
      "Tempo",
      "Elbow range of motion",
      "Torso lean (arching check)",
      "Left/right symmetry"
    ],
    "notMeasured": [
      "The dumbbells are not detected — load is not measured",
      "Shoulder joint stress",
      "Force"
    ],
    "gateableMetrics": [
      "rep_count",
      "rom_top_angle",
      "lumbar_flexion_proxy"
    ],
    "scoreDisplay": "band"
  },
  "formErrors": [
    {
      "id": "lumbar_arch",
      "label": "Arching your back to press",
      "priority": "safety",
      "detect": {
        "metric": "lumbar_flexion_proxy",
        "op": ">",
        "value": 16
      },
      "cue": "Ribs down — press with your shoulders, not your lower back.",
      "perturbation": {
        "metric": "lumbar_flexion_proxy",
        "targetValue": 24,
        "via": {
          "segment": "lumbar",
          "deltaDeg": 20
        }
      }
    },
    {
      "id": "partial_lockout",
      "label": "Not locking out overhead",
      "priority": "blocking",
      "detect": {
        "metric": "rom_top_angle",
        "op": "<",
        "value": 155
      },
      "cue": "Press all the way until your arms are straight.",
      "perturbation": {
        "metric": "rom_top_angle",
        "targetValue": 130,
        "via": {
          "clampAt": 130
        }
      }
    }
  ],
  "cues": {
    "setup": [
      "Stand side-on, arms in frame at the top."
    ],
    "during": [
      "Ribs down.",
      "Press tall."
    ],
    "success": [
      "Full lockout, no arch."
    ]
  },
  "safety": {
    "warnings": [],
    "hardGate": false
  },
  "courses": [
    "shoulder_foundations"
  ],
  "provenance": {
    "sources": [],
    "consensusN": 0,
    "status": "pending_harvest"
  },
  "passiveExecutionPossible": false,
  "$passiveRationale": "Pasif icra İMKÂNSIZ: kullanıcı ya ağırlık tutuyor (gevşerse düşürür) ya da vücudunu taşıyor (gevşerse çöker). Kimse başkasına pasif şınav yaptıramaz. M-F-45: bu beyanla `unknown` kaynak referansa uygun — çünkü pasif kirlenme fiziksel olarak mümkün değil."
}
