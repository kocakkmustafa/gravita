      "Lift height over time",
      "Time until you start to drop"
    ],
    "notMeasured": [
      "How hard it feels",
      "Force"
    ],
    "gateableMetrics": [
      "hold_duration_s",
      "time_to_form_break_s"
    ],
    "scoreDisplay": "band"
  },
  "formErrors": [
    {
      "id": "neck_crank",
      "label": "Cranking your neck back",
      "priority": "safety",
      "detect": {
        "metric": "neck_flexion_proxy",
        "op": "<",
        "value": -15
