        "metric": "neck_flexion_proxy",
        "targetValue": -24,
        "via": {
          "joint": "neck",
          "deltaDeg": -24
        }
      }
    }
  ],
  "cues": {
    "setup": [
      "Lie face down, arms forward."
    ],
    "during": [
